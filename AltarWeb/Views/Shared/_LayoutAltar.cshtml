<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AltarWeb</title>
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('altarweb-theme') || 'system';
                var sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                var resolved = saved === 'system' ? (sysDark ? 'dark' : 'light') : saved;
                document.documentElement.dataset.theme = resolved;
                document.documentElement.dataset.themePref = saved;
            } catch (e) {}
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/altar-design.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="altar-root">
    @RenderBody()

    <div id="altar-datepicker-modal" class="altar-datepicker-overlay" role="dialog" aria-modal="true" aria-labelledby="altar-datepicker-campo">
        <div class="altar-datepicker">
            <div class="altar-datepicker-intro">
                <div id="altar-datepicker-campo" class="altar-datepicker-campo"></div>
                <div id="altar-datepicker-actual" class="altar-datepicker-actual"></div>
            </div>

            <div class="altar-datepicker-header">
                <div class="altar-datepicker-navgroup">
                    <button type="button" class="altar-datepicker-nav" onclick="AltarDatePicker.cambiarAnio(-1)" aria-label="A&ntilde;o anterior" title="A&ntilde;o anterior"><i class="fa-solid fa-angles-left" aria-hidden="true"></i></button>
                    <button type="button" class="altar-datepicker-nav" onclick="AltarDatePicker.cambiarMes(-1)" aria-label="Mes anterior" title="Mes anterior"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
                </div>
                <span id="altar-datepicker-titulo" class="altar-datepicker-titulo" aria-live="polite"></span>
                <div class="altar-datepicker-navgroup">
                    <button type="button" class="altar-datepicker-nav" onclick="AltarDatePicker.cambiarMes(1)" aria-label="Mes siguiente" title="Mes siguiente"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
                    <button type="button" class="altar-datepicker-nav" onclick="AltarDatePicker.cambiarAnio(1)" aria-label="A&ntilde;o siguiente" title="A&ntilde;o siguiente"><i class="fa-solid fa-angles-right" aria-hidden="true"></i></button>
                </div>
            </div>

            <div class="altar-datepicker-dow" aria-hidden="true">
                <span>D</span><span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span>
            </div>
            <div id="altar-datepicker-grid" class="altar-datepicker-grid"></div>

            <p class="altar-datepicker-ayuda">Elige un d&iacute;a para aplicarlo. El d&iacute;a de hoy lleva un punto debajo. Con el teclado: flechas para moverte, Re/Av P&aacute;g para cambiar de mes, Esc para cerrar.</p>

            <div class="altar-datepicker-acciones">
                <button type="button" class="altar-btn altar-btn-sm altar-btn-outline" onclick="AltarDatePicker.hoy()"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i> Hoy</button>
                <button type="button" id="altar-datepicker-limpiar" class="altar-btn altar-btn-sm altar-btn-outline altar-btn-danger" onclick="AltarDatePicker.limpiar()" hidden><i class="fa-solid fa-eraser" aria-hidden="true"></i> Quitar fecha</button>
                <button type="button" class="altar-btn altar-btn-sm altar-btn-outline" onclick="AltarDatePicker.cerrar()">Cancelar</button>
            </div>
        </div>
    </div>

    <script>
        var AltarTheme = (function () {
            var mq = null;

            function resolved(pref) {
                if (pref === 'system') {
                    return (mq && mq.matches) ? 'dark' : 'light';
                }
                return pref;
            }

            function aplicar(pref) {
                document.documentElement.dataset.theme = resolved(pref);
                document.documentElement.dataset.themePref = pref;
                document.querySelectorAll('[data-theme-option]').forEach(function (btn) {
                    btn.classList.toggle('active', btn.dataset.themeOption === pref);
                });
            }

            function setTheme(pref) {
                try { localStorage.setItem('altarweb-theme', pref); } catch (e) {}
                aplicar(pref);
            }

            function inicializar() {
                try {
                    mq = window.matchMedia('(prefers-color-scheme: dark)');
                    mq.addEventListener('change', function () {
                        if ((localStorage.getItem('altarweb-theme') || 'system') === 'system') aplicar('system');
                    });
                } catch (e) {}

                var pref = 'system';
                try { pref = localStorage.getItem('altarweb-theme') || 'system'; } catch (e) {}
                aplicar(pref);
            }

            document.addEventListener('DOMContentLoaded', inicializar);

            return { setTheme: setTheme };
        })();

        var AltarSidebarNav = (function () {
            function toggle() {
                var sidebar = document.getElementById('altar-sidebar');
                var overlay = document.getElementById('altar-sidebar-overlay');
                if (!sidebar) return;
                sidebar.classList.contains('open') ? close() : open();
            }
            function open() {
                var sidebar = document.getElementById('altar-sidebar');
                var overlay = document.getElementById('altar-sidebar-overlay');
                if (sidebar) sidebar.classList.add('open');
                if (overlay) overlay.classList.add('open');
            }
            function close() {
                var sidebar = document.getElementById('altar-sidebar');
                var overlay = document.getElementById('altar-sidebar-overlay');
                if (sidebar) sidebar.classList.remove('open');
                if (overlay) overlay.classList.remove('open');
            }
            return { toggle: toggle, open: open, close: close };
        })();

    </script>

    <!-- jQuery debe cargarse antes de la seccion Scripts: las vistas con formulario incluyen ahi
         _ValidationScriptsPartial (jquery.validate + unobtrusive), que depende de jQuery. -->
    <script src="~/js/altar-datepicker.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
