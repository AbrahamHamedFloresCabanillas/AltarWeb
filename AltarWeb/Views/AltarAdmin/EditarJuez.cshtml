@model AltarWeb.ViewModels.Altar.EditarJuezViewModel
@{
    ViewData["Title"] = "Editar usuario";
}

<div class="altar-app">
    <partial name="_AltarSidebarPartial" model="(AltarWeb.ViewModels.Altar.AltarNavContext)ViewBag.Nav" />

    <main class="altar-main" style="max-width:520px;">
        <a asp-controller="AltarAdmin" asp-action="Jueces" class="altar-text-muted" style="display:inline-block; margin-bottom:16px;"><i class="fa-solid fa-arrow-left"></i> Volver</a>
        <div class="altar-page-title">Editar usuario</div>
        <div class="altar-page-subtitle" style="margin-bottom:20px;">
            @(Model.EsCuentaLocal ? "Cuenta local" : "Cuenta de Google")
            @if (Model.Pendiente)
            {
                <span class="altar-badge altar-badge-warning" style="margin-left:6px;"><i class="fa-solid fa-hourglass-half"></i> Pendiente de aprobaci&oacute;n</span>
            }
            else if (Model.Inactivo)
            {
                <span class="altar-badge altar-badge-danger" style="margin-left:6px;">Inactivo</span>
            }
        </div>

        <div class="altar-card">
            <form asp-controller="AltarAdmin" asp-action="EditarJuez" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="altar-error"></div>

                <div class="altar-field">
                    <label class="altar-label">Nombre completo</label>
                    <input asp-for="NombreCompleto" class="altar-input" />
                    <span asp-validation-for="NombreCompleto" class="altar-error"></span>
                </div>

                @if (Model.EsCuentaLocal)
                {
                    <div class="altar-field">
                        <label class="altar-label">Usuario</label>
                        <input asp-for="Usuario" class="altar-input" />
                        <span asp-validation-for="Usuario" class="altar-error"></span>
                    </div>
                }
                else
                {
                    <div class="altar-field">
                        <label class="altar-label">Correo institucional</label>
                        <input value="@Model.CorreoInstitucional" class="altar-input" disabled />
                        <p class="altar-slider-hint">Inicia sesi&oacute;n con Google; el correo no se edita desde aqu&iacute;.</p>
                    </div>
                }

                <div class="altar-field">
                    <label class="altar-label">Rol</label>
                    <select asp-for="Rol" class="altar-select" disabled="@(Model.EsLaPropiaCuenta ? "disabled" : null)">
                        <option value="Juez">Juez</option>
                        <option value="Admin">Administrador</option>
                    </select>
                    @if (Model.EsLaPropiaCuenta)
                    {
                        <input type="hidden" asp-for="Rol" />
                        <p class="altar-slider-hint">No puedes cambiar el rol de tu propia cuenta.</p>
                    }
                    <span asp-validation-for="Rol" class="altar-error"></span>
                </div>

                @if (Model.EsCuentaLocal)
                {
                    <div class="altar-field">
                        <label class="altar-label">Nueva contrase&ntilde;a <span class="altar-text-muted">(opcional)</span></label>
                        <input asp-for="NuevaPassword" type="password" class="altar-input" autocomplete="new-password" placeholder="Dejar vac&iacute;o para conservar la actual" />
                        <span asp-validation-for="NuevaPassword" class="altar-error"></span>
                        @if (!Model.EsLaPropiaCuenta)
                        {
                            <p class="altar-slider-hint">Si la cambias, el usuario deber&aacute; elegir una nueva en su pr&oacute;ximo inicio de sesi&oacute;n.</p>
                        }
                    </div>
                }

                <button type="submit" class="altar-btn altar-btn-primary altar-btn-block"><i class="fa-solid fa-floppy-disk"></i> Guardar cambios</button>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
