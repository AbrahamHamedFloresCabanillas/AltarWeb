@model AltarWeb.Models.Juez
@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="altar-app">
    <partial name="_AltarSidebarPartial" model="(AltarWeb.ViewModels.Altar.AltarNavContext)ViewBag.Nav" />

    <main class="altar-main" style="max-width:520px;">
        <a asp-controller="AltarAdmin" asp-action="Jueces" class="altar-text-muted" style="display:inline-block; margin-bottom:16px;"><i class="fa-solid fa-arrow-left"></i> Volver</a>
        <div class="altar-page-title" style="margin-bottom:20px;">Nuevo usuario</div>

        <div class="altar-card">
            <form asp-controller="AltarAdmin" asp-action="CrearJuez" method="post">
                <div asp-validation-summary="ModelOnly" class="altar-error"></div>
                <div class="altar-field">
                    <label class="altar-label">Nombre completo</label>
                    <input asp-for="NombreCompleto" class="altar-input" />
                </div>
                <div class="altar-field">
                    <label class="altar-label">Usuario</label>
                    <input asp-for="Usuario" class="altar-input" />
                </div>
                <div class="altar-field">
                    <label class="altar-label">Contrase&ntilde;a</label>
                    <input asp-for="Password" type="password" class="altar-input" />
                </div>
                <div class="altar-field">
                    <label class="altar-label">Rol</label>
                    <select asp-for="Rol" class="altar-select">
                        <option value="Juez">Juez</option>
                        <option value="Admin">Administrador</option>
                    </select>
                </div>
                <button type="submit" class="altar-btn altar-btn-primary altar-btn-block">Crear usuario</button>
            </form>
        </div>
    </main>
</div>
