@model List<AltarWeb.Models.Juez>
@{
    ViewData["Title"] = "Gestión de jueces";
}

<div class="altar-app">
    <partial name="_AltarSidebarPartial" model="(AltarWeb.ViewModels.Altar.AltarNavContext)ViewBag.Nav" />

    <main class="altar-main">
        <div class="altar-flex" style="justify-content:space-between; margin-bottom:20px;">
            <div>
                <div class="altar-page-title">Gesti&oacute;n de jueces</div>
                <div class="altar-page-subtitle">Crea, edita y administra el acceso de jueces y administradores.</div>
            </div>
            <a asp-controller="AltarAdmin" asp-action="CrearJuez" class="altar-btn altar-btn-primary"><i class="fa-solid fa-user-plus"></i> Nuevo usuario</a>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="altar-hint" style="border-color:var(--altar-primary); color:var(--altar-primary);">@TempData["Mensaje"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="altar-error" style="margin-bottom:12px;">@TempData["Error"]</div>
        }

        <div class="altar-card">
            <table class="altar-table">
                <thead>
                    <tr><th>Nombre</th><th>Usuario / Correo</th><th>Rol</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var j in Model)
                    {
                        var inicial = !string.IsNullOrEmpty(j.NombreCompleto) ? j.NombreCompleto.Substring(0, 1)
                            : !string.IsNullOrEmpty(j.Usuario) ? j.Usuario.Substring(0, 1)
                            : !string.IsNullOrEmpty(j.CorreoInstitucional) ? j.CorreoInstitucional.Substring(0, 1)
                            : "?";
                        <tr>
                            <td>
                                <div class="altar-flex altar-gap-sm">
                                    <div class="altar-avatar" style="width:28px; height:28px; font-size:11px;">@inicial</div>
                                    @j.NombreCompleto
                                </div>
                            </td>
                            <td>@(j.Usuario ?? j.CorreoInstitucional)</td>
                            <td><span class="altar-badge @(j.Rol == "Admin" ? "altar-badge-warning" : "altar-badge-success")">@j.Rol</span></td>
                            <td>
                                @if (j.Pendiente)
                                {
                                    <span class="altar-badge altar-badge-warning"><i class="fa-solid fa-hourglass-half"></i> Pendiente</span>
                                }
                                else if (j.IsDeleted)
                                {
                                    <span class="altar-badge altar-badge-danger">Inactivo</span>
                                }
                                else
                                {
                                    <span class="altar-badge altar-badge-success">Activo</span>
                                }
                            </td>
                            <td>
                                @if (j.Pendiente)
                                {
                                    <form asp-controller="AltarAdmin" asp-action="AprobarJuez" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@j.Id" />
                                        <button type="submit" class="altar-btn-sm altar-btn-outline" style="color:var(--altar-primary);"><i class="fa-solid fa-check"></i> Aprobar</button>
                                    </form>
                                }
                                else if (j.IsDeleted)
                                {
                                    <form asp-controller="AltarAdmin" asp-action="ReactivarJuez" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@j.Id" />
                                        <button type="submit" class="altar-btn-sm altar-btn-outline" style="color:var(--altar-primary);"><i class="fa-solid fa-rotate-left"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="AltarAdmin" asp-action="DesactivarJuez" method="post" style="display:inline;" onsubmit="return confirm('¿Desactivar este usuario?');">
                                        <input type="hidden" name="id" value="@j.Id" />
                                        <button type="submit" class="altar-btn-sm altar-btn-outline" style="color:var(--altar-danger);"><i class="fa-solid fa-user-slash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>
