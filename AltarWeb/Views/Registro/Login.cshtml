@model AltarWeb.ViewModels.Altar.RegistroLoginViewModel
@{
    ViewData["Title"] = "Acceso";
}

<div class="altar-landing">
    <div class="altar-landing-brand">
        <div>
            <div class="altar-brand">
                <div class="altar-brand-badge"><i class="fa-solid fa-skull"></i></div>
                <div>
                    <div style="font-weight:800; font-size:20px;">AltarWeb</div>
                    <div style="opacity:0.85; font-size:13px;">FIM &middot; UABC</div>
                </div>
            </div>

            <div class="altar-eyebrow" style="margin-top:40px;">Concurso de Altares de Muertos</div>
            <div class="altar-landing-heading">Evaluaci&oacute;n cultural, constancias y resultados por carrera.</div>
            <p style="opacity:0.9; max-width:420px;">
                Plataforma oficial de la Facultad de Ingenier&iacute;a para registrar participantes,
                evaluar altares bajo los nuevos criterios culturales y emitir constancias para todos.
            </p>

            <div class="altar-flex altar-gap-sm" style="flex-wrap:wrap; margin-top:20px;">
                <span class="altar-chip"><i class="fa-solid fa-layer-group"></i> Evaluaci&oacute;n por niveles</span>
                <span class="altar-chip"><i class="fa-solid fa-ranking-star"></i> Ranking por carrera</span>
                <span class="altar-chip"><i class="fa-solid fa-file-shield"></i> Constancias para todos</span>
            </div>
        </div>

        <div style="opacity:0.85; font-size:13px;">Mexicali, Baja California &middot; Universidad Aut&oacute;noma de Baja California</div>
    </div>

    <div class="altar-landing-form">
        <div class="altar-landing-form-inner">
            @{
                var tabInicial = ViewBag.Tab as string ?? "registro";
                var errorMsg = ViewBag.Error as string;
            }
            <div class="altar-flex" style="justify-content:flex-end; margin-bottom:12px;">
                <partial name="_AltarThemeTogglePartial" />
            </div>
            <div class="altar-pill-tabs" style="margin-bottom:24px;">
                <button type="button" class="altar-pill-tab @(tabInicial == "acceso" ? "active" : "")" data-tab="acceso" onclick="altarShowTab('acceso')">
                    <i class="fa-solid fa-user"></i> Jueces / Admin
                </button>
                <button type="button" class="altar-pill-tab @(tabInicial == "registro" ? "active" : "")" data-tab="registro" onclick="altarShowTab('registro')">
                    <i class="fa-solid fa-id-card"></i> Registro
                </button>
            </div>

            <div id="tab-acceso" style="display:@(tabInicial == "acceso" ? "block" : "none");">
                <h3 class="altar-card-title">Acceso del personal</h3>
                <p class="altar-card-subtitle">Ingresa con tu usuario asignado por el comit&eacute;.</p>

                @if (tabInicial == "acceso" && !string.IsNullOrEmpty(errorMsg))
                {
                    <div class="altar-error" style="margin-bottom:12px;">@errorMsg</div>
                }

                <a asp-controller="Registro" asp-action="GoogleLogin" asp-route-intent="juez" class="altar-btn altar-btn-outline altar-btn-block" style="margin-bottom:16px;">
                    <i class="fa-brands fa-google"></i> Continuar con Google
                </a>
                <div class="altar-flex altar-gap-sm" style="align-items:center; margin-bottom:16px;">
                    <div style="flex:1; height:1px; background:var(--altar-border);"></div>
                    <span class="altar-text-muted" style="font-size:12px;">o con usuario y contrase&ntilde;a</span>
                    <div style="flex:1; height:1px; background:var(--altar-border);"></div>
                </div>

                <form asp-controller="Acceso" asp-action="Login" method="post">
                    <div class="altar-field">
                        <label class="altar-label">Usuario o correo</label>
                        <input type="text" name="usuario" class="altar-input" />
                    </div>
                    <div class="altar-field">
                        <label class="altar-label">Contrase&ntilde;a</label>
                        <input type="password" name="password" class="altar-input" />
                    </div>
                    <button type="submit" class="altar-btn altar-btn-primary altar-btn-block">Entrar</button>
                </form>

                <p style="text-align:center; margin-top:16px; font-size:14px;" class="altar-text-muted">
                    &iquest;Eres juez y no tienes cuenta? <a asp-controller="Registro" asp-action="SignupJuez"><strong>Solicita acceso</strong></a>
                </p>
            </div>

            <div id="tab-registro" style="display:@(tabInicial == "registro" ? "block" : "none");">
                <h3 class="altar-card-title">Portal de Registro</h3>
                <p class="altar-card-subtitle">Para <strong>alumnos, maestros y administrativos</strong>. Usa tu correo <strong>@@uabc.edu.mx</strong>.</p>

                @if (tabInicial == "registro" && !string.IsNullOrEmpty(errorMsg))
                {
                    <div class="altar-error" style="margin-bottom:12px;">@errorMsg</div>
                }

                <a asp-controller="Registro" asp-action="GoogleLogin" asp-route-intent="registrante" class="altar-btn altar-btn-outline altar-btn-block" style="margin-bottom:16px;">
                    <i class="fa-brands fa-google"></i> Continuar con Google
                </a>
                <div class="altar-flex altar-gap-sm" style="align-items:center; margin-bottom:16px;">
                    <div style="flex:1; height:1px; background:var(--altar-border);"></div>
                    <span class="altar-text-muted" style="font-size:12px;">o con correo y contrase&ntilde;a</span>
                    <div style="flex:1; height:1px; background:var(--altar-border);"></div>
                </div>

                <form asp-controller="Registro" asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="altar-error"></div>
                    <div class="altar-field">
                        <label class="altar-label">Correo institucional</label>
                        <input asp-for="CorreoInstitucional" class="altar-input" placeholder="nombre.apellido@uabc.edu.mx" />
                        <span asp-validation-for="CorreoInstitucional" class="altar-error"></span>
                    </div>
                    <div class="altar-field">
                        <label class="altar-label">Contrase&ntilde;a</label>
                        <input asp-for="Password" type="password" class="altar-input" />
                        <span asp-validation-for="Password" class="altar-error"></span>
                    </div>

                    <div class="altar-hint">
                        <i class="fa-solid fa-circle-info"></i>
                        Identificador: matr&iacute;cula de <strong>7 d&iacute;gitos</strong> (alumno) &middot; <strong>5 d&iacute;gitos</strong> (maestro / administrativo).
                    </div>

                    <button type="submit" class="altar-btn altar-btn-primary altar-btn-block">Entrar al portal</button>
                </form>

                <p style="text-align:center; margin-top:16px; font-size:14px;" class="altar-text-muted">
                    &iquest;Primera vez? <a asp-controller="Registro" asp-action="Signup"><strong>Reg&iacute;strate con tu identificador</strong></a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function altarShowTab(tab) {
            document.getElementById('tab-acceso').style.display = tab === 'acceso' ? 'block' : 'none';
            document.getElementById('tab-registro').style.display = tab === 'registro' ? 'block' : 'none';
            document.querySelectorAll('.altar-pill-tab').forEach(function (btn) {
                btn.classList.toggle('active', btn.dataset.tab === tab);
            });
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}
