@model AltarWeb.ViewModels.Altar.RegistroSignupJuezViewModel
@{
    ViewData["Title"] = "Regístrate como juez";
}

<div class="altar-landing">
    <div class="altar-landing-brand">
        <div>
            <div class="altar-brand">
                <div class="altar-brand-badge"><i class="fa-solid fa-skull"></i></div>
                <div>
                    <div style="font-weight:800; font-size:20px;">AltarWeb</div>
                    <div style="opacity:0.85; font-size:13px;">FIM &middot; UABC</div>
                </div>
            </div>
            <div class="altar-eyebrow" style="margin-top:40px;">Acceso de personal</div>
            <div class="altar-landing-heading">Reg&iacute;strate como juez.</div>
            <p style="opacity:0.9; max-width:420px;">
                Tu solicitud queda pendiente hasta que un administrador la apruebe.
            </p>
        </div>
        <div style="opacity:0.85; font-size:13px;">Mexicali, Baja California &middot; Universidad Aut&oacute;noma de Baja California</div>
    </div>

    <div class="altar-landing-form">
        <div class="altar-landing-form-inner">
            <h3 class="altar-card-title">Solicitar acceso como juez</h3>
            <p class="altar-card-subtitle">Usa tu correo <strong>@@uabc.edu.mx</strong>.</p>

            <a asp-controller="Registro" asp-action="GoogleLogin" asp-route-intent="juez" class="altar-btn altar-btn-outline altar-btn-block" style="margin-bottom:16px;">
                <i class="fa-brands fa-google"></i> Continuar con Google
            </a>
            <div class="altar-flex altar-gap-sm" style="align-items:center; margin-bottom:16px;">
                <div style="flex:1; height:1px; background:var(--altar-border);"></div>
                <span class="altar-text-muted" style="font-size:12px;">o con correo y contrase&ntilde;a</span>
                <div style="flex:1; height:1px; background:var(--altar-border);"></div>
            </div>

            <form asp-controller="Registro" asp-action="SignupJuez" method="post">
                <div asp-validation-summary="ModelOnly" class="altar-error"></div>

                <div class="altar-field">
                    <label class="altar-label">Nombre completo</label>
                    <input asp-for="NombreCompleto" class="altar-input" />
                    <span asp-validation-for="NombreCompleto" class="altar-error"></span>
                </div>

                <div class="altar-field">
                    <label class="altar-label">Correo institucional</label>
                    <input asp-for="CorreoInstitucional" class="altar-input" placeholder="nombre.apellido@uabc.edu.mx" />
                    <span asp-validation-for="CorreoInstitucional" class="altar-error"></span>
                </div>

                <div class="altar-field">
                    <label class="altar-label">Matr&iacute;cula o n&uacute;mero de empleado</label>
                    <input asp-for="Identificador" class="altar-input" inputmode="numeric" maxlength="5" placeholder="5 dígitos" />
                    <span asp-validation-for="Identificador" class="altar-error"></span>
                </div>

                <div class="altar-grid-2">
                    <div class="altar-field">
                        <label class="altar-label">Contrase&ntilde;a</label>
                        <input asp-for="Password" type="password" class="altar-input" />
                        <span asp-validation-for="Password" class="altar-error"></span>
                    </div>
                    <div class="altar-field">
                        <label class="altar-label">Confirmar contrase&ntilde;a</label>
                        <input asp-for="ConfirmarPassword" type="password" class="altar-input" />
                        <span asp-validation-for="ConfirmarPassword" class="altar-error"></span>
                    </div>
                </div>

                <button type="submit" class="altar-btn altar-btn-primary altar-btn-block">Enviar solicitud</button>
            </form>

            <p style="text-align:center; margin-top:16px; font-size:14px;" class="altar-text-muted">
                &iquest;Ya tienes cuenta? <a asp-controller="Registro" asp-action="Login" asp-route-tab="acceso"><strong>Inicia sesi&oacute;n</strong></a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
