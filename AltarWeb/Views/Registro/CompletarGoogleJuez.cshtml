@model AltarWeb.ViewModels.Altar.CompletarGoogleJuezViewModel
@{
    ViewData["Title"] = "Completa tu registro";
}

<div class="altar-landing">
    <div class="altar-landing-brand">
        <div>
            <div class="altar-brand">
                <div class="altar-brand-badge"><i class="fa-solid fa-skull"></i></div>
                <div>
                    <div style="font-weight:800; font-size:20px;">AltarWeb</div>
                    <div style="opacity:0.85; font-size:13px;">FIM &middot; UABC</div>
                </div>
            </div>
            <div class="altar-eyebrow" style="margin-top:40px;">Casi listo</div>
            <div class="altar-landing-heading">Un &uacute;ltimo paso.</div>
            <p style="opacity:0.9; max-width:420px;">
                Google no comparte tu matr&iacute;cula. Compl&eacute;tala para enviar tu solicitud de acceso como juez.
            </p>
        </div>
        <div style="opacity:0.85; font-size:13px;">Mexicali, Baja California &middot; Universidad Aut&oacute;noma de Baja California</div>
    </div>

    <div class="altar-landing-form">
        <div class="altar-landing-form-inner">
            <h3 class="altar-card-title">Completa tu solicitud</h3>
            <p class="altar-card-subtitle">Bienvenido, <strong>@Model.NombreCompleto</strong> &middot; @Model.CorreoInstitucional</p>

            <form asp-controller="Registro" asp-action="CompletarGoogleJuez" method="post">
                <div asp-validation-summary="ModelOnly" class="altar-error"></div>
                <input type="hidden" asp-for="NombreCompleto" />
                <input type="hidden" asp-for="CorreoInstitucional" />

                <div class="altar-field">
                    <label class="altar-label">Matr&iacute;cula o n&uacute;mero de empleado</label>
                    <input asp-for="Identificador" class="altar-input" inputmode="numeric" maxlength="5" placeholder="5 dígitos" />
                    <span asp-validation-for="Identificador" class="altar-error"></span>
                </div>

                <div class="altar-hint">
                    <i class="fa-solid fa-hourglass-half"></i>
                    Tu solicitud quedar&aacute; pendiente hasta que un administrador la apruebe.
                </div>

                <button type="submit" class="altar-btn altar-btn-primary altar-btn-block">Enviar solicitud</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
