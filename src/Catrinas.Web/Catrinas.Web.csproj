<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Catrinas.Web: plataforma independiente del Concurso de Catrinas (docs/01-decision-arquitectura.md).
    Ejecutable, DbContext, migraciones, base de datos, configuracion, cookie y llaves propias.
    Solo depende de Concurso.Core (infraestructura transversal); NUNCA de Altares.Web.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Misma razon que en Altares.Web: SqlClient 6.1.7 arrastra Pkcs 9.0.11 (GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Concurso.Core\Concurso.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Concurso.Core.Seguridad" />
    <Using Include="Concurso.Core.Identidad" />
    <Using Include="Concurso.Core.Privacidad" />
    <Using Include="Concurso.Core.Fechas" />
    <Using Include="Concurso.Core.Correo" />
    <Using Include="Concurso.Core.Pdf" />
  </ItemGroup>

  <!-- F4: la configuracion local (el archivo donde irian credenciales) y las plantillas NUNCA viajan en el paquete.
       En el hosting la configuracion y los secretos van en las variables de entorno del sitio (panel de MonsterASP), ver docs/05-despliegue-catrinas.md. -->
  <ItemGroup>
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- F4: GC de estacion de trabajo. El de servidor reserva memoria por nucleo y el hosting limita a 512 MB
       por sitio; con este GC la prueba de PDF (20 descargas concurrentes, heap limitado a 384 MB) no tuvo
       errores. Sustituye el ajuste manual de runtimeconfig.json que pedia la guia anterior. -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

</Project>
