{
  "_comentario": "Plantilla SIN secretos: lista las claves de configuracion. En local se copia como appsettings.json (ignorado por git). En el hosting NO se sube ningun appsettings: cada clave se define como variable de entorno del sitio en el panel de MonsterASP (Scripting > Environment variables), con __ en lugar de : (p. ej. ConnectionStrings__CatrinasContext). Ver docs/05-despliegue-catrinas.md. Catrinas usa SU PROPIA base, cliente OAuth y buzon.",
  "ConnectionStrings": {
    "CatrinasContext": "Server=SERVIDOR_SQL;Database=BASE_DE_CATRINAS;User Id=USUARIO_SQL;Password=CONTRASENA_SQL;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "GoogleAuth": {
    "ClientId": "CLIENTE_OAUTH_DE_CATRINAS.apps.googleusercontent.com",
    "ClientSecret": "SECRETO_DEL_CLIENTE_OAUTH_DE_CATRINAS",
    "ExigirDominioWorkspace": true,
    "DominioWorkspace": "uabc.edu.mx"
  },
  "Smtp": {
    "Host": "SERVIDOR_SMTP_DEL_HOSTING",
    "Port": 587,
    "EnableSsl": true,
