<div class="altar-theme-seg">
    <button type="button" class="altar-theme-seg-btn" data-theme-option="light" title="Claro" onclick="CatrinasTema.set('light')"><i class="fa-solid fa-sun"></i></button>
    <button type="button" class="altar-theme-seg-btn" data-theme-option="dark" title="Oscuro" onclick="CatrinasTema.set('dark')"><i class="fa-solid fa-moon"></i></button>
    <button type="button" class="altar-theme-seg-btn" data-theme-option="system" title="Sistema" onclick="CatrinasTema.set('system')"><i class="fa-solid fa-desktop"></i></button>
</div>
