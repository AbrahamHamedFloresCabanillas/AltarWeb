@model List<EvaluacionCatrina>
@{
    ViewData["Title"] = "Ranking por carrera";
}

<div class="altar-app">
    <partial name="_Sidebar" model="(NavContext)ViewBag.Nav" />
    <main class="altar-main">
        <div class="altar-page-title">Ranking por carrera</div>
        <div class="altar-page-subtitle">Periodo @ViewBag.Periodo · solo evaluaciones Final. Notas iguales comparten lugar: no hay criterio de desempate definido por el comité.</div>

        @if (Model.Count == 0)
        {
            <div class="altar-card"><p class="altar-text-muted">Aún no hay evaluaciones Final en este periodo.</p></div>
        }
        @foreach (var grupo in Model.GroupBy(e => e.SnapshotCarrera))
        {
            <div class="altar-card">
                <div class="altar-card-title">@grupo.Key</div>
                <table class="altar-table">
                    <thead><tr><th>Lugar</th><th>Inscripción</th><th>Personifica</th><th>Nota</th></tr></thead>
                    <tbody>
                        @foreach (var e in grupo)
                        {
                            <tr>
                                <td>@(e.Lugar != null ? $"{e.Lugar}.º" : "—")</td>
                                <td><a asp-action="Detalle" asp-route-id="@e.Id">@e.SnapshotNombreInscripcion</a></td>
                                <td>@e.SnapshotPersonificador</td>
                                <td>@e.NotaCatrina.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </main>
</div>
