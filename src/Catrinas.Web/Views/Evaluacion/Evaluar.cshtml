@model EvaluarViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Evaluar Catrina";
    string Inv(decimal v) => v.ToString(CultureInfo.InvariantCulture);
    // B3 (2026-10-21): cada criterio lleva una guia breve de que evaluar, como las de Altares. Texto propuesto,
    // pendiente de que el comite lo ratifique (vision.md §7.5 solo define nombres y pesos).
    var criterios = new (string Campo, string Etiqueta, decimal Peso, decimal Valor, string Guia)[]
    {
        ("vestuario", "Vestuario", Model.Pesos.PesoVestuario, Model.Vestuario,
            "Confección, calidad y coherencia del atuendo con la figura de la Catrina."),
        ("maquillaje", "Maquillaje", Model.Pesos.PesoMaquillaje, Model.Maquillaje,
            "Técnica, detalle y acabado del maquillaje de calavera."),
        ("accesorios", "Accesorios", Model.Pesos.PesoAccesorios, Model.Accesorios,
            "Complementos (sombrero, flores, joyería, abanico…) y cómo enriquecen la caracterización."),
        ("originalidadCreatividad", "Originalidad y creatividad", Model.Pesos.PesoOriginalidadCreatividad, Model.OriginalidadCreatividad,
            "Qué tan propia, novedosa y bien lograda es la interpretación de la Catrina."),
        ("apegoTradiciones", "Apego a las tradiciones", Model.Pesos.PesoApegoTradiciones, Model.ApegoTradiciones,
            "Respeto a los elementos tradicionales de la Catrina y del Día de Muertos.")
    };
    var notaInicial = criterios.Sum(c => c.Valor * c.Peso);
    var esFinal = Model.Estado == EstadoEvaluacion.Final;
}

<div class="altar-app">
    <partial name="_Sidebar" model="(NavContext)ViewBag.Nav" />
    <main class="altar-main">
        <a asp-action="Index" class="altar-text-muted"><i class="fa-solid fa-arrow-left"></i> Inscripciones</a>
        <div class="altar-page-title" style="margin-top:8px;">@Model.Nombre</div>
        <div class="altar-page-subtitle">@Model.Carrera · @(Model.Estado?.ToString() ?? "Sin evaluar")</div>

        <partial name="_Mensajes" />

        <div class="altar-grid-2">
            <div class="altar-card">
                <div class="altar-card-title">Inscripción (solo lectura)</div>
                <p><i class="fa-solid fa-masks-theater"></i> Personifica: <strong>@(Model.Personificador ?? "sin designar")</strong></p>
                <p>Integrantes: @string.Join(", ", Model.Integrantes.Select(i => i.Nombre))</p>
                <p>Maestro encargado: @(Model.MaestroEncargado ?? "ninguno")</p>
                @if (Model.AltarExternalId != null)
                {
                    <p class="altar-text-muted" style="font-size:13px;">Equipo de Altares asociado (referencia declarada): @Model.AltarExternalId@(Model.AltarNombre != null ? $" · {Model.AltarNombre}" : "")</p>
                }
                @if (Model.Faltantes.Count > 0)
                {
                    <div class="altar-error">No se puede cerrar como Final hasta que la inscripción tenga: @string.Join(", ", Model.Faltantes).</div>
                }
                @if (!Model.PesosValidos)
                {
                    <div class="altar-error">Los pesos configurados no suman 100%. La administración debe corregirlos antes de evaluar.</div>
                }
            </div>

            <div class="altar-card">
                <div class="altar-card-title">Criterios de evaluación de la personificación (0–10)</div>
                <form asp-action="Guardar" method="post" id="form-evaluacion">
                    <input type="hidden" name="inscripcionId" value="@Model.InscripcionId" />
                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                    <input type="hidden" name="confirmacion" id="confirmacion" value="" />
                    @foreach (var c in criterios)
                    {
                        <div class="altar-slider-row">
                            <div class="altar-slider-row-head">
                                <span>@c.Etiqueta · @((c.Peso * 100).ToString("0"))%</span>
                                <span id="out-@c.Campo">@c.Valor.ToString("0.0")</span>
                            </div>
                            <input type="range" min="0" max="10" step="0.1" name="@c.Campo" value="@Inv(c.Valor)" class="altar-slider" data-peso="@Inv(c.Peso)" @(esFinal ? "disabled" : null) />
                            <div class="altar-slider-hint">@c.Guia</div>
                        </div>
                    }
                    <div class="altar-flex" style="justify-content:space-between; margin:16px 0;">
                        <span>Nota de Catrina</span>
                        <span id="out-nota" style="font-size:24px; font-weight:800;">@notaInicial.ToString("0.00")</span>
                    </div>
                    @if (!esFinal)
                    {
                        <div class="altar-flex altar-gap-sm">
                            <button type="submit" name="accion" value="preliminar" class="altar-btn altar-btn-outline"><i class="fa-solid fa-floppy-disk"></i> Guardar como Preliminar</button>
                            <button type="submit" name="accion" value="final" class="altar-btn altar-btn-primary" onclick="return catrinasConfirmarFinal()" @(Model.Faltantes.Count > 0 ? "disabled" : null)><i class="fa-solid fa-lock"></i> Cerrar como Final</button>
                        </div>
                    }
                </form>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        function catrinasNota() {
            var nota = 0;
            document.querySelectorAll('#form-evaluacion input[type=range]').forEach(function (s) {
                document.getElementById('out-' + s.name).textContent = parseFloat(s.value).toFixed(1);
                nota += parseFloat(s.value) * parseFloat(s.dataset.peso);
            });
            document.getElementById('out-nota').textContent = nota.toFixed(2);
            return nota;
        }
        document.querySelectorAll('#form-evaluacion input[type=range]').forEach(function (s) { s.addEventListener('input', catrinasNota); });
        function catrinasConfirmarFinal() {
            var ok = confirm('¿Estás de acuerdo? Al cerrar como Final la nota (' + catrinasNota().toFixed(2) + ') ya no podrá modificarse.');
            if (ok) document.getElementById('confirmacion').value = '@EvaluacionController.ConfirmacionFinal';
            return ok;
        }
    </script>
}
