@model EvaluacionCatrina
@{
    ViewData["Title"] = "Evaluación";
    var esFinal = Model.Estado == EstadoEvaluacion.Final;
}

<div class="altar-app">
    <partial name="_Sidebar" model="(NavContext)ViewBag.Nav" />
    <main class="altar-main">
        <a asp-action="Index" class="altar-text-muted"><i class="fa-solid fa-arrow-left"></i> Inscripciones</a>
        <div class="altar-page-title" style="margin-top:8px;">@Model.SnapshotNombreInscripcion</div>
        <div class="altar-page-subtitle">@Model.SnapshotCarrera · @Model.Estado · periodo @Model.Periodo</div>

        <partial name="_Mensajes" />

        <div class="altar-grid-2">
            <div class="altar-card">
                <div class="altar-card-title">Resultado</div>
                <div style="font-size:32px; font-weight:800; color:var(--altar-primary);">@Model.NotaCatrina.ToString("0.00")</div>
                <p>@(Model.Lugar != null ? $"{Model.Lugar}.º lugar en {Model.SnapshotCarrera}" : "Fuera del podio o pendiente")</p>
                <table class="altar-table">
                    <tbody>
                        <tr><td>Vestuario (@((Model.PesoVestuario * 100).ToString("0"))%)</td><td>@Model.Vestuario.ToString("0.0")</td></tr>
                        <tr><td>Maquillaje (@((Model.PesoMaquillaje * 100).ToString("0"))%)</td><td>@Model.Maquillaje.ToString("0.0")</td></tr>
                        <tr><td>Accesorios (@((Model.PesoAccesorios * 100).ToString("0"))%)</td><td>@Model.Accesorios.ToString("0.0")</td></tr>
                        <tr><td>Originalidad y creatividad (@((Model.PesoOriginalidadCreatividad * 100).ToString("0"))%)</td><td>@Model.OriginalidadCreatividad.ToString("0.0")</td></tr>
                        <tr><td>Apego a las tradiciones (@((Model.PesoApegoTradiciones * 100).ToString("0"))%)</td><td>@Model.ApegoTradiciones.ToString("0.0")</td></tr>
                    </tbody>
                </table>
                <p class="altar-text-muted" style="font-size:12px;">Jurado: @(Model.Juez?.NombreCompleto ?? "—") · Personifica: @Model.SnapshotPersonificador</p>
            </div>

            <div class="altar-card">
                <div class="altar-card-title">Constancias</div>
                @if (esFinal)
                {
                    <div class="altar-flex altar-gap-sm" style="flex-wrap:wrap;">
                        <a asp-controller="Constancia" asp-action="Grupal" asp-route-evaluacionId="@Model.Id" class="altar-btn altar-btn-outline"><i class="fa-solid fa-file-pdf"></i> Grupal</a>
                        <a asp-controller="Constancia" asp-action="Individuales" asp-route-evaluacionId="@Model.Id" class="altar-btn altar-btn-outline"><i class="fa-solid fa-file-zipper"></i> Individuales (ZIP)</a>
                        @if (!string.IsNullOrWhiteSpace(Model.SnapshotMaestroEncargado))
                        {
                            <a asp-controller="Constancia" asp-action="Maestro" asp-route-evaluacionId="@Model.Id" class="altar-btn altar-btn-outline"><i class="fa-solid fa-file-pdf"></i> Maestro encargado</a>
                        }
                        <a asp-controller="Constancia" asp-action="Jurado" asp-route-evaluacionId="@Model.Id" class="altar-btn altar-btn-outline"><i class="fa-solid fa-file-pdf"></i> Jurado</a>
                    </div>
                    <form asp-controller="Constancia" asp-action="EnviarTodas" method="post" style="margin-top:12px;">
                        <input type="hidden" name="evaluacionId" value="@Model.Id" />
                        <button type="submit" class="altar-btn altar-btn-primary"><i class="fa-solid fa-paper-plane"></i> Enviar todas por correo</button>
                    </form>
                }
                else
                {
                    <p class="altar-text-muted">Las constancias se generan cuando la evaluación se cierra como Final.</p>
                    <a asp-action="Evaluar" asp-route-inscripcionId="@Model.InscripcionId" class="altar-btn altar-btn-primary">Continuar evaluación</a>
                }
                <div class="altar-card-subtitle" style="margin-top:16px;">Integrantes (al evaluar)</div>
                <ul>
                    @foreach (var i in Model.Integrantes.OrderBy(x => x.NombreCompleto))
                    {
                        <li>@i.NombreCompleto @(i.Rol == RolInscripcion.Personificador ? "(personifica)" : "")</li>
                    }
                </ul>
            </div>
        </div>
    </main>
</div>
