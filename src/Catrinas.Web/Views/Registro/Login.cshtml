@model LoginParticipanteViewModel
@{
    ViewData["Title"] = "Acceso";
    var tab = ViewBag.Tab as string ?? "participantes";
    var error = ViewBag.Error as string;
}

<div class="altar-landing">
    <div class="altar-landing-brand">
        <div>
            <div class="altar-brand">
                <div class="altar-brand-badge"><i class="fa-solid fa-hat-wizard"></i></div>
                <div>
                    <div style="font-weight:800; font-size:20px;">Concurso de Catrinas</div>
                    <div style="opacity:0.85; font-size:13px;">FIM · UABC</div>
                </div>
            </div>

            <div class="altar-eyebrow" style="margin-top:40px;">Personificación de Catrinas</div>
            <div class="altar-landing-heading">Inscripción, evaluación del jurado y constancias por carrera.</div>
            <p style="opacity:0.9; max-width:420px;">
                Plataforma oficial de la Facultad de Ingeniería para inscribir equipos de Catrina, evaluar
                vestuario, maquillaje, accesorios, originalidad y apego a las tradiciones, y emitir constancias.
            </p>
            <div class="altar-flex altar-gap-sm" style="flex-wrap:wrap; margin-top:20px;">
                <span class="altar-chip"><i class="fa-solid fa-masks-theater"></i> Cinco criterios</span>
                <span class="altar-chip"><i class="fa-solid fa-ranking-star"></i> Ranking por carrera</span>
                <span class="altar-chip"><i class="fa-solid fa-file-shield"></i> Constancias para todos</span>
            </div>
        </div>
        <div style="opacity:0.85; font-size:13px;">Mexicali, Baja California · Universidad Autónoma de Baja California</div>
    </div>

    <div class="altar-landing-form">
        <div class="altar-landing-form-inner">
            <div class="altar-flex" style="justify-content:flex-end; margin-bottom:12px;"><partial name="_TemaPartial" /></div>
            <div class="altar-pill-tabs" style="margin-bottom:24px;">
                <button type="button" class="altar-pill-tab @(tab == "jurado" ? "active" : "")" data-tab="jurado" onclick="catrinasTab('jurado')"><i class="fa-solid fa-user"></i> Jurado / Admin</button>
                <button type="button" class="altar-pill-tab @(tab == "participantes" ? "active" : "")" data-tab="participantes" onclick="catrinasTab('participantes')"><i class="fa-solid fa-id-card"></i> Participantes</button>
            </div>

            <div id="tab-jurado" style="display:@(tab == "jurado" ? "block" : "none");">
                <h3 class="altar-card-title">Acceso del jurado</h3>
                <p class="altar-card-subtitle">Ingresa con la cuenta que te asignó la administración del concurso.</p>
                @if (tab == "jurado" && !string.IsNullOrEmpty(error))
                {
                    <div class="altar-error" style="margin-bottom:12px;">@error</div>
                }
                <a asp-action="GoogleLogin" asp-route-intent="jurado" class="altar-btn altar-btn-outline altar-btn-block" style="margin-bottom:16px;"><i class="fa-brands fa-google"></i> Continuar con Google</a>
                <form asp-controller="Acceso" asp-action="Login" method="post">
                    <div class="altar-field">
                        <label class="altar-label" for="usuario">Usuario o correo</label>
                        <input type="text" id="usuario" name="usuario" class="altar-input" autocomplete="username" />
                    </div>
                    <div class="altar-field">
                        <label class="altar-label" for="password">Contraseña</label>
                        <input type="password" id="password" name="password" class="altar-input" autocomplete="current-password" />
                    </div>
                    <button type="submit" class="altar-btn altar-btn-primary altar-btn-block">Entrar</button>
                </form>
                <p style="text-align:center; margin-top:16px; font-size:14px;" class="altar-text-muted">
                    ¿Formas parte del jurado y no tienes cuenta? <a asp-action="SolicitarJurado"><strong>Solicita acceso</strong></a>
                </p>
            </div>

            <div id="tab-participantes" style="display:@(tab == "participantes" ? "block" : "none");">
                <h3 class="altar-card-title">Participantes</h3>
                <p class="altar-card-subtitle">Para <strong>alumnos, maestros y administrativos</strong>. Usa tu correo <strong>@@uabc.edu.mx</strong>.</p>
                @if (tab == "participantes" && !string.IsNullOrEmpty(error))
                {
                    <div class="altar-error" style="margin-bottom:12px;">@error</div>
                }
                <a asp-action="GoogleLogin" asp-route-intent="participante" class="altar-btn altar-btn-outline altar-btn-block" style="margin-bottom:16px;"><i class="fa-brands fa-google"></i> Continuar con Google</a>
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="altar-error"></div>
                    <div class="altar-field">
                        <label class="altar-label" asp-for="CorreoInstitucional">Correo institucional</label>
                        <input asp-for="CorreoInstitucional" class="altar-input" placeholder="nombre.apellido@uabc.edu.mx" />
                        <span asp-validation-for="CorreoInstitucional" class="altar-error"></span>
                    </div>
                    <div class="altar-field">
                        <label class="altar-label" asp-for="Password">Contraseña</label>
                        <input asp-for="Password" type="password" class="altar-input" />
                        <span asp-validation-for="Password" class="altar-error"></span>
                    </div>
                    <button type="submit" class="altar-btn altar-btn-primary altar-btn-block">Entrar al portal</button>
                </form>
                <p style="text-align:center; margin-top:16px; font-size:14px;" class="altar-text-muted">
                    ¿Primera vez? <a asp-action="Signup"><strong>Crea tu cuenta</strong></a>
                </p>
            </div>

            <partial name="_EnlacesLegales" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function catrinasTab(tab) {
            ['jurado', 'participantes'].forEach(function (t) { document.getElementById('tab-' + t).style.display = t === tab ? 'block' : 'none'; });
            document.querySelectorAll('.altar-pill-tab').forEach(function (b) { b.classList.toggle('active', b.dataset.tab === tab); });
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}
