@{
    ViewData["Title"] = "Cambia tu contraseña";
    var error = ViewData.ModelState.IsValid ? null : ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage;
}

<div class="altar-landing">
    <div class="altar-landing-brand">
        <div>
            <div class="altar-brand">
                <div class="altar-brand-badge"><i class="fa-solid fa-skull"></i></div>
                <div>
                    <div style="font-weight:800; font-size:20px;">AltarWeb</div>
                    <div style="opacity:0.85; font-size:13px;">FIM &middot; UABC</div>
                </div>
            </div>
            <div class="altar-eyebrow" style="margin-top:40px;">Seguridad de tu cuenta</div>
            <div class="altar-landing-heading">Debes cambiar tu contrase&ntilde;a.</div>
            <p style="opacity:0.9; max-width:420px;">
                Esta cuenta tiene una contrase&ntilde;a temporal o generada por el sistema. Antes de continuar,
                defin&iacute; una nueva contrase&ntilde;a propia.
            </p>
        </div>
        <div style="opacity:0.85; font-size:13px;">Mexicali, Baja California &middot; Universidad Aut&oacute;noma de Baja California</div>
    </div>

    <div class="altar-landing-form">
        <div class="altar-landing-form-inner">
            <h3 class="altar-card-title">Nueva contrase&ntilde;a</h3>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="altar-error" style="margin-bottom:12px;">@error</div>
            }

            <form asp-controller="Acceso" asp-action="CambiarPasswordObligatorio" method="post">
                <div class="altar-field">
                    <label class="altar-label">Nueva contrase&ntilde;a</label>
                    <input type="password" name="nuevaPassword" class="altar-input" minlength="8" required />
                </div>
                <div class="altar-field">
                    <label class="altar-label">Confirmar contrase&ntilde;a</label>
                    <input type="password" name="confirmarPassword" class="altar-input" minlength="8" required />
                </div>
                <div class="altar-hint">
                    <i class="fa-solid fa-circle-info"></i>
                    M&iacute;nimo 8 caracteres.
                </div>
                <button type="submit" class="altar-btn altar-btn-primary altar-btn-block">Guardar y continuar</button>
            </form>
        </div>
    </div>
</div>
