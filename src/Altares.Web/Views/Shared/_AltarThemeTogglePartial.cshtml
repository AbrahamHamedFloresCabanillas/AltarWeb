<div class="altar-theme-seg" id="altar-theme-seg">
    <button type="button" class="altar-theme-seg-btn" data-theme-option="light" title="Claro" onclick="AltarTheme.setTheme('light')">
        <i class="fa-solid fa-sun"></i>
    </button>
    <button type="button" class="altar-theme-seg-btn" data-theme-option="dark" title="Oscuro" onclick="AltarTheme.setTheme('dark')">
        <i class="fa-solid fa-moon"></i>
    </button>
    <button type="button" class="altar-theme-seg-btn" data-theme-option="system" title="Sistema" onclick="AltarTheme.setTheme('system')">
        <i class="fa-solid fa-desktop"></i>
    </button>
</div>
