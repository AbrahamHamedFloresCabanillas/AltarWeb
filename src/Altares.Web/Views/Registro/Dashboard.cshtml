@model AltarWeb.ViewModels.Altar.RegistranteDashboardViewModel
@{
    ViewData["Title"] = "Mi portal";
    var primerNombre = Model.Registrante.NombreCompleto.Split(' ').FirstOrDefault() ?? Model.Registrante.NombreCompleto;
}

<div style="max-width:1100px; margin:0 auto; padding:28px 24px;">
    <div class="altar-flex" style="justify-content:space-between; margin-bottom:28px;">
        <div class="altar-flex altar-gap-sm">
            <div class="altar-brand-badge" style="width:36px; height:36px; background:var(--altar-primary-soft-bg); font-size:16px;"><i class="fa-solid fa-skull"></i></div>
            <div>
                <div style="font-weight:800;">Portal de Registro</div>
                <div class="altar-text-muted" style="font-size:12px;">Concurso de Altares &middot; FIM UABC</div>
            </div>
        </div>
        <div class="altar-flex altar-gap-md">
            <partial name="_AltarThemeTogglePartial" />
            <div class="altar-flex altar-gap-sm">
                <div class="altar-avatar">@Model.Registrante.NombreCompleto.Substring(0, 1)</div>
                <div>
                    <div style="font-weight:700; font-size:13px;">@Model.Registrante.NombreCompleto</div>
                    <div class="altar-text-muted" style="font-size:12px;">@Model.Registrante.Tipo &middot; @Model.Registrante.Identificador</div>
                </div>
            </div>
            <a asp-controller="Registro" asp-action="Logout" style="color:var(--altar-text-muted);"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="altar-hint" style="border-color:var(--altar-primary); color:var(--altar-primary);">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="altar-error" style="margin-bottom:12px;">@TempData["Error"]</div>
    }

    <h2 style="font-weight:800;">&iexcl;Hola, @primerNombre!</h2>
    <p class="altar-text-muted" style="margin-bottom:24px;">
        Periodo acad&eacute;mico <strong>@PeriodoHelper.ObtenerPeriodoActual()</strong>
        @if (Model.Registrante.CatalogoCarrera != null)
        {
            <text> &middot; @Model.Registrante.CatalogoCarrera.Nombre</text>
        }
    </p>

    <div class="altar-grid-2">
        <div>
            @if (Model.Equipo == null)
            {
                @foreach (var invitacion in Model.Invitaciones)
                {
                    <div class="altar-card" style="border-color:var(--altar-primary);">
                        <div class="altar-card-title"><i class="fa-solid fa-envelope-open-text"></i> Invitaci&oacute;n a un equipo</div>
                        <p class="altar-card-subtitle">
                            <strong>@invitacion.Organizador</strong> te invit&oacute; a su equipo <strong>@invitacion.Equipo</strong>
                            (altar &quot;@invitacion.NombreAltar&quot; &middot; @invitacion.Carrera). Solo quedas en el equipo si aceptas.
                        </p>
                        <div class="altar-flex altar-gap-sm">
                            <form asp-controller="Registro" asp-action="AceptarInvitacion" method="post" style="display:inline;">
                                <input type="hidden" name="invitacionId" value="@invitacion.Id" />
                                <button type="submit" class="altar-btn altar-btn-primary"><i class="fa-solid fa-check"></i> Aceptar</button>
                            </form>
                            <form asp-controller="Registro" asp-action="RechazarInvitacion" method="post" style="display:inline;">
                                <input type="hidden" name="invitacionId" value="@invitacion.Id" />
                                <button type="submit" class="altar-btn altar-btn-outline">Rechazar</button>
                            </form>
                        </div>
                    </div>
                }
                <div class="altar-card">
                    <div class="altar-card-title">A&uacute;n no tienes equipo</div>
                    <p class="altar-card-subtitle">Crea tu equipo y llena la Ficha de Registro del Altar para participar en el concurso.</p>
                    <a asp-controller="Registro" asp-action="CrearEquipo" class="altar-btn altar-btn-primary">
                        <i class="fa-solid fa-plus"></i> Crear mi equipo
                    </a>
                </div>
            }
            else
            {
                <div class="altar-card">
                    <div class="altar-flex altar-gap-sm" style="margin-bottom:12px;">
                        @if (Model.EsOrganizador)
                        {
                            <span class="altar-badge altar-badge-success"><i class="fa-solid fa-crown"></i> Organizador</span>
                        }
                        <span class="altar-badge @(Model.FichaCompleta ? "altar-badge-success" : "altar-badge-warning")">
                            <i class="fa-solid @(Model.FichaCompleta ? "fa-file-circle-check" : "fa-triangle-exclamation")"></i>
                            Ficha @(Model.FichaCompleta ? "completa" : "pendiente")
                        </span>
                    </div>

                    @* Un badge "pendiente" sin decir que falta obliga a abrir la ficha y adivinar. *@
                    @if (Model.FichaFaltantes.Any())
                    {
                        <div class="altar-hint" style="border-color:var(--altar-amber); color:var(--altar-amber);">
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                            Falta capturar en la Ficha de Registro: <strong>@string.Join(", ", Model.FichaFaltantes)</strong>.
                            @if (Model.EsOrganizador && !Model.EdicionBloqueada)
                            {
                                <a asp-controller="Registro" asp-action="Ficha">Completar ahora</a>
                            }
                            else if (!Model.EsOrganizador)
                            {
                                <text>Solo el organizador del equipo puede completarla.</text>
                            }
                        </div>
                    }

                    <div class="altar-card-title" style="color:var(--altar-primary);">@Model.Equipo.Nombre</div>
                    <div class="altar-card-subtitle" style="font-style:italic;">Altar &quot;@Model.Equipo.NombreAltar&quot;</div>
                    <div class="altar-text-muted" style="font-size:13px;"><i class="fa-solid fa-hashtag"></i> C&oacute;digo del equipo: <strong data-codigo-publico>@Model.Equipo.CodigoPublico</strong></div>

                    <div class="altar-flex altar-gap-sm" style="flex-wrap:wrap; margin:14px 0;">
                        <span class="altar-chip" style="background:var(--altar-surface-alt); color:var(--altar-text);"><i class="fa-solid fa-graduation-cap"></i> @Model.Equipo.Carrera?.Nombre</span>
                        @if (Model.Equipo.MaestroEncargado != null)
                        {
                            <span class="altar-chip" style="background:var(--altar-surface-alt); color:var(--altar-text);"><i class="fa-solid fa-chalkboard-user"></i> @Model.Equipo.MaestroEncargado.NombreCompleto</span>
                        }
                        else if (!string.IsNullOrEmpty(Model.Equipo.MaestroEncargadoIdentificadorPendiente))
                        {
                            <span class="altar-chip" style="background:var(--altar-surface-alt); color:var(--altar-amber); opacity:0.7;"><i class="fa-solid fa-hourglass-half"></i> Maestro pendiente de registro</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Equipo.UbicacionAltar))
                        {
                            <span class="altar-chip" style="background:var(--altar-surface-alt); color:var(--altar-text);"><i class="fa-solid fa-location-dot"></i> @Model.Equipo.UbicacionAltar</span>
                        }
                        @if (Model.Equipo.Difunto != null)
                        {
                            <span class="altar-chip" style="background:var(--altar-surface-alt); color:var(--altar-text);"><i class="fa-solid fa-cross"></i> @Model.Equipo.Difunto.Nombre &middot; @Model.Equipo.Difunto.FechaDefuncion.ToString("d MMM yyyy")</span>
                        }
                    </div>

                    <div>
                        @if (Model.Equipo.MaestroEncargado != null || !string.IsNullOrEmpty(Model.Equipo.MaestroEncargadoIdentificadorPendiente))
                        {
                            <div class="altar-flex altar-gap-sm" style="padding:8px 0; border-top:1px solid var(--altar-border); @(Model.Equipo.MaestroEncargado == null ? "opacity:0.5;" : "")">
                                <div class="altar-avatar" style="width:28px; height:28px; font-size:11px; background:var(--altar-surface-alt); color:var(--altar-text-muted);"><i class="fa-solid fa-chalkboard-user"></i></div>
                                <div style="flex:1;">@(Model.Equipo.MaestroEncargado?.NombreCompleto ?? "Maestro encargado (pendiente)")</div>
                                <span class="altar-badge altar-badge-muted">Maestro encargado</span>
                            </div>
                        }
                        @foreach (var integrante in Model.Equipo.Integrantes.OrderByDescending(i => i.Rol == AltarWeb.Models.Registro.RolEquipo.Narrador))
                        {
                            <div class="altar-flex altar-gap-sm" style="padding:8px 0; border-top:1px solid var(--altar-border);">
                                <div class="altar-avatar" style="width:28px; height:28px; font-size:11px;">@integrante.Registrante.NombreCompleto.Substring(0,1)</div>
                                <div style="flex:1;">@integrante.Registrante.NombreCompleto</div>
                                @if (integrante.Rol == AltarWeb.Models.Registro.RolEquipo.Narrador)
                                {
                                    <span class="altar-badge altar-badge-purple">Narrador</span>
                                }
                                <span class="altar-text-muted" style="font-size:13px;">@integrante.Registrante.Identificador</span>
                            </div>
                        }
                    </div>

                    @if (Model.EsOrganizador && !Model.EdicionBloqueada)
                    {
                        <a asp-controller="Registro" asp-action="Ficha" class="altar-btn altar-btn-outline altar-btn-sm" style="margin-top:14px;">
                            <i class="fa-solid fa-pen"></i> Editar Ficha de Registro
                        </a>
                    }

                    @if (Model.EdicionBloqueada)
                    {
                        <div class="altar-hint" style="margin-top:14px;">
                            <i class="fa-solid fa-lock"></i> El equipo ya tiene una calificaci&oacute;n registrada: la ficha y la lista de integrantes est&aacute;n cerradas.
                        </div>
                    }
                </div>
            }

            <div class="altar-card">
                <div class="altar-card-title">Mi constancia</div>
                @if (Model.EquipoEvaluado)
                {
                    <a asp-controller="Constancia" asp-action="DescargarMia" class="altar-btn altar-btn-outline">
                        <i class="fa-solid fa-download"></i> Descargar mi constancia
                    </a>
                }
                else
                {
                    <button class="altar-btn altar-btn-outline" disabled title="Disponible cuando tu equipo tenga una evaluación Final">
                        <i class="fa-solid fa-download"></i> Descargar mi constancia
                    </button>
                }
            </div>

            <div class="altar-card">
                <div class="altar-card-title"><i class="fa-solid fa-book"></i> Manual del participante</div>
                <p class="altar-card-subtitle">Gu&iacute;a paso a paso para crear tu equipo, invitar integrantes y completar la Ficha.</p>
                <a href="/Manual/Participante?ver=1" target="_blank" rel="noopener" class="altar-btn altar-btn-primary"><i class="fa-solid fa-eye"></i> Ver</a>
                <a href="/Manual/Participante" class="altar-btn altar-btn-outline"><i class="fa-solid fa-file-pdf"></i> Descargar (PDF)</a>
            </div>
        </div>

        <div>
            @{
                var esFinal = Model.Equipo?.Evaluacion?.Estado == AltarWeb.Models.Registro.EstadoEvaluacion.Final;
            }
            @if (Model.Equipo?.Evaluacion != null && Model.Equipo.Evaluacion.NotaFinal != null)
            {
                <div class="altar-card" style="background:@(esFinal ? "var(--altar-primary-soft-bg)" : "var(--altar-amber-soft-bg)"); border-color:@(esFinal ? "var(--altar-primary)" : "var(--altar-amber)");">
                    <div class="altar-card-subtitle" style="color:var(--altar-text);">@(esFinal ? "Resultado de evaluación" : "Resultado preliminar de evaluación")</div>
                    <div style="font-size:36px; font-weight:800; color:@(esFinal ? "var(--altar-primary)" : "var(--altar-amber)");">@Model.Equipo.Evaluacion.NotaFinal?.ToString("0.0") / 10</div>
                    @if (!esFinal)
                    {
                        <span class="altar-badge altar-badge-warning"><i class="fa-solid fa-pencil"></i> Sujeto a cambios hasta que el juez lo cierre como Final</span>
                    }
                    else if (Model.Equipo.Evaluacion.Lugar != null)
                    {
                        <span class="altar-badge altar-badge-success">@Model.Equipo.Evaluacion.Lugar&#176; lugar &middot; @Model.Equipo.Carrera?.Nombre</span>
                    }
                </div>
            }

            <div class="altar-card">
                <div class="altar-card-title">Elementos requeridos del altar &middot; @Model.Elementos.Count elementos</div>
                <p class="altar-card-subtitle">Esto es lo que tu altar debe incluir.</p>

                <div class="altar-grid-2">
                    @foreach (var el in Model.Elementos)
                    {
                        <div class="altar-flex altar-gap-sm" style="padding:8px 0;">
                            <span class="altar-badge @(el.Categoria == AltarWeb.Models.Registro.CategoriaElemento.RitualObligatorio ? "altar-badge-success" : "altar-badge-muted")" style="font-size:10px;">
                                @(el.Categoria == AltarWeb.Models.Registro.CategoriaElemento.RitualObligatorio ? "Ritual" : "Decor.")
                            </span>
                            <span style="flex:1; font-size:13px;">@el.Nombre</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
