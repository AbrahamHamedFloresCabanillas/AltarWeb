<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- F1 (2026-10-17): el proyecto se renombro a Altares.Web pero conserva el namespace AltarWeb
         para no reescribir cada archivo; ensamblado y ejecutable se llaman Altares.Web. -->
    <RootNamespace>AltarWeb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2025.7.4" />
    <!--
      Fija la version parcheada de una dependencia transitiva de runtime:
      Microsoft.EntityFrameworkCore.SqlServer 10 -> Microsoft.Data.SqlClient 6.1.7 arrastra
      System.Security.Cryptography.Pkcs 9.0.11, afectada por GHSA-846f-f764-76mx (Alta) y
      GHSA-2fmv-rv2c-59x7 (Moderada), ambas parcheadas en 10.0.13. Se puede quitar cuando SqlClient
      dependa de una version corregida.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Concurso.Core\Concurso.Core.csproj" />
  </ItemGroup>

  <!-- Namespaces de Concurso.Core disponibles en todo el proyecto (los .cshtml usan _ViewImports). -->
  <ItemGroup>
    <Using Include="Concurso.Core.Seguridad" />
    <Using Include="Concurso.Core.Identidad" />
    <Using Include="Concurso.Core.Privacidad" />
    <Using Include="Concurso.Core.Fechas" />
    <Using Include="Concurso.Core.Correo" />
  </ItemGroup>

  <!--
    DEP-01: herramienta de scaffolding de tiempo de diseño (dotnet-aspnet-codegenerator). Arrastra
    transitivamente NuGet.Packaging/NuGet.Protocol 6.11.0 (advisory GHSA-g4vj-cjjj-v7hg, severidad Baja).
    No se necesita en runtime, así que se condiciona a builds Debug para no incluirla (ni su
    dependencia vulnerable) en el artefacto de producción (`dotnet publish -c Release`), sin perder la
    herramienta de scaffolding en desarrollo local (`dotnet run` / IDE, que compilan en Debug).
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
  </ItemGroup>

  <!-- F4: la configuracion local (el archivo donde irian credenciales) y las plantillas NUNCA viajan en el paquete.
       En el hosting la configuracion y los secretos van en las variables de entorno del sitio (panel de MonsterASP), ver docs/04-despliegue-altares.md. -->
  <ItemGroup>
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- F4: GC de estacion de trabajo. El de servidor reserva memoria por nucleo y el hosting limita a 512 MB
       por sitio; con este GC la prueba de PDF (20 descargas concurrentes, heap limitado a 384 MB) no tuvo
       errores. Sustituye el ajuste manual de runtimeconfig.json que pedia la guia anterior. -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

</Project>
